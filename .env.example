# Copy to .env and fill in. NEVER commit .env.

# ---------- DATA: Zetaris (local Docker install) ----------
# Zetaris REST API base
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
# Numeric Zetaris organisation id
ZETARIS_ORG_ID=1
# Admin key: only used to register sources and governance (data/zetaris/*.sql).
ZETARIS_API_KEY=your-zetaris-admin-api-key
# The agent's own key: a Zetaris user assigned to role autopilot_agent (data/zetaris/02_governance.sql); empty = admin fallback, development only
AUTOPILOT_ZETARIS_API_KEY=

# ---------- POWER: Meterless Nightshift (the only model provider) ----------
# Model provider name (only meterless is supported)
MODEL_PROVIDER=meterless
# App id sent to Nightshift for usage attribution
METERLESS_APP=adspend-autopilot
# Nightshift Runtime URL (Nightshift > Console)
MODEL_BASE_URL=http://127.0.0.1:8088/v1
# Nightshift Runtime token (Nightshift > Console). NOT your NVIDIA key.
MODEL_API_KEY=your-nightshift-runtime-token
# Routing mode: meterless/deep for cloud Nemotron lanes, meterless/text.local for a local Nemotron lane
NEMOTRON_MODEL=meterless/deep
# Seconds to wait for one model call (default 180)
MODEL_CALL_TIMEOUT_S=600
# Reasoning effort sent with model calls: low (default), medium, high, or none to omit it
MODEL_REASONING_EFFORT=low

# ---------- Autopilot ----------
# The cycle's "today". The demo data ends Sun 2026-10-18.
AUTOPILOT_AS_OF=2026-10-19
# Host the web server binds to (default 127.0.0.1; do not expose without an authenticated tunnel)
AUTOPILOT_HOST=127.0.0.1
# Port for the web server (default 4180)
AUTOPILOT_PORT=4180
# Optional HMAC secret for Scout contracts; leave commented out to use a random secret generated in .autopilot/keys/ (an empty value is used as-is)
# SCOUT_SIGNING_SECRET=

# ---------- Demo Postgres (data/docker-compose.yml) ----------
# Password for the demo Postgres container (default autopilot_local_dev)
AUTOPILOT_PG_PASSWORD=autopilot_local_dev
